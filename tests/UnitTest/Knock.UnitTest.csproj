<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- EXC-006: IStartupValidator está obsoleto en .NET 11; las pruebas de arranque se portan a IAsyncStartupValidator -->
    <NoWarn>$(NoWarn);SYSLIB0066</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Knock.UnitTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Knock.Market.Api\Knock.Market.Api.csproj" />
    <ProjectReference Include="..\..\src\Knock.Identity.Api\Knock.Identity.Api.csproj" Aliases="global,identity" />
    <ProjectReference Include="..\..\src\Knock.Messaging.Api\Knock.Messaging.Api.csproj" Aliases="messaging" />
    <ProjectReference Include="..\..\src\Knock.Gateway\Knock.Gateway.csproj" Aliases="gateway" />
    <ProjectReference Include="..\..\src\Knock.Contracts\Knock.Contracts.csproj" />
  </ItemGroup>
</Project>
