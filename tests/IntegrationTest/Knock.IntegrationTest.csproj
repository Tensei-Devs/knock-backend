<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Alias: Identity.Api y Gateway declaran un Program global; el alias evita la ambigüedad en este proyecto. -->
    <ProjectReference Include="..\..\src\Knock.Identity.Api\Knock.Identity.Api.csproj" Aliases="IdentityApi" />
  </ItemGroup>

  <ItemGroup>
    <!-- documentdb-local compartido con DatabaseTest: un solo archivo, sin duplicar la imagen fijada por digest. -->
    <Compile Include="..\DatabaseTest\Support\DocumentDbFixture.cs" Link="Support\DocumentDbFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Knock.Gateway\Knock.Gateway.csproj" />
    <!-- Media (spec 013, OI-2): pruebas de integración de los servicios internos contra Azurite, sin endpoints.
         Alias: Market.Api y Gateway declaran un Program global; el alias evita la ambigüedad. -->
    <ProjectReference Include="..\..\src\Knock.Market.Api\Knock.Market.Api.csproj" Aliases="MarketApi" />
  </ItemGroup>

</Project>
