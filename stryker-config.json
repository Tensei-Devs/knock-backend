{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Configuration/stryker-config.schema.json",
  "stryker-config": {
    "solution": "Knock.slnx",
    "test-projects": [
      "tests/UnitTest/Knock.UnitTest.csproj"
    ],
    "test-case-filter": "FullyQualifiedName~Knock.UnitTest",
    "mutate": [
      "**/Knock.Identity.Api/Modules/Sesiones/**/*.cs",
      "**/Knock.Identity.Api/Modules/Usuarios/**/*.cs",
      "**/Knock.Market.Api/Modules/Catalog/**/*.cs",
      "**/Knock.Market.Api/Modules/Requests/**/*.cs",
      "**/Knock.Gateway/**/*.cs",
      "!**/obj/**",
      "!**/bin/**",
      "!**/*.g.cs",
      "!**/*.Designer.cs",
      "!**/Migrations/**",
      "!**/Program.cs"
    ],
    "reporters": ["progress", "html", "json", "markdown"],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "concurrency": 4
  }
}
