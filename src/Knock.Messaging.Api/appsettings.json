{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Ready": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "knock-api",
    "Audience": "knock-app"
  },
  "Redis": {
    "Database": 0,
    "ConnectTimeoutSeconds": 5,
    "SyncTimeoutSeconds": 5
  },
  "Observability": {
    "ServiceName": "knock-messaging",
    "SamplingRatio": 1.0,
    "EnableLiveMetrics": false
  },
  "Mongo": {
    "Region": "westus",
    "MaxPoolSize": 20,
    "ServerSelectionTimeoutSeconds": 5,
    "ConnectTimeoutSeconds": 5,
    "SocketTimeoutSeconds": 10,
    "QueryMaxTimeSeconds": 5,
    "Databases": {
      "Messaging": "messaging"
    }
  }
}
