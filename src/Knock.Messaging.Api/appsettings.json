{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "knock-messaging",
    "SamplingRatio": 1.0,
    "EnableLiveMetrics": false
  },
  "Mongo": {
    "Region": "westus",
    "MaxPoolSize": 20,
    "ServerSelectionTimeoutSeconds": 5,
    "ConnectTimeoutSeconds": 5,
    "SocketTimeoutSeconds": 10,
    "QueryMaxTimeSeconds": 5,
    "Databases": {
      "Messaging": "messaging"
    }
  }
}
