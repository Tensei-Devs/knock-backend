{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "knock-api",
    "Audience": "knock-app"
  },
  "Security": {
    "Cors": {
      "AllowedOrigins": []
    }
  },
  "RateLimiting": {
    "Ip": { "PermitLimit": 100, "Window": "00:01:00" },
    "Auth": { "PermitLimit": 10, "Window": "00:01:00" },
    "User": { "PermitLimit": 120, "Window": "00:01:00" }
  },
  "Redis": {
    "Database": 0,
    "ConnectTimeoutSeconds": 5,
    "SyncTimeoutSeconds": 5
  },
  "ReverseProxy": {
    "Routes": {
      "identidad-sesion-firebase": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/auth/firebase" } },
      "identidad-sesion-renovacion": { "ClusterId": "identidad", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/auth/refresh" } },
      "identidad-sesion": { "ClusterId": "identidad", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/auth/{**resto}" } },
      "identidad-perfil": { "ClusterId": "identidad", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/me/{**resto}" } },
      "mercado-oficios": { "ClusterId": "mercado", "AuthorizationPolicy": "anonymous", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/oficios/{**resto}" } },
      "mercado-colonias": { "ClusterId": "mercado", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/colonias/{**resto}" } },
      "mensajeria-mensajes": { "ClusterId": "mensajeria", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/mensajes/{**resto}" } },
      "mensajeria-notificaciones": { "ClusterId": "mensajeria", "AuthorizationPolicy": "default", "CorsPolicy": "knock", "Match": { "Path": "/api/v1/notificaciones/{**resto}" } }
    },
    "Clusters": {
      "identidad": { "Destinations": { "principal": { "Address": "http://localhost:5062/" } } },
      "mercado": { "Destinations": { "principal": { "Address": "http://localhost:5234/" } } },
      "mensajeria": { "Destinations": { "principal": { "Address": "http://localhost:5226/" } } }
    }
  }
}
