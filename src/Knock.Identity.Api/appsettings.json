{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "ServiceName": "knock-identity",
    "SamplingRatio": 1.0,
    "EnableLiveMetrics": false
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "Window": "00:01:00"
    },
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "Ready": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  },
  "Security": {
    "Hsts": {
      "MaxAge": "365.00:00:00",
      "IncludeSubDomains": true
    },
    "Cors": {
      "AllowedOrigins": [],
      "PreflightMaxAge": "00:10:00"
    }
  },
  "Jwt": {
    "Issuer": "knock-api",
    "Audience": "knock-app"
  },
  "Consentimientos": {
    "AvisoPrivacidad": "1.0",
    "Terminos": "1.0"
  },
  "Firebase": {
    "ProjectId": "knock-0"
  },
  "Mongo": {
    "Region": "westus",
    "MaxPoolSize": 20,
    "ServerSelectionTimeoutSeconds": 5,
    "ConnectTimeoutSeconds": 5,
    "SocketTimeoutSeconds": 10,
    "QueryMaxTimeSeconds": 5,
    "Databases": {
      "Identity": "identity"
    }
  },
  "Redis": {
    "Database": 0,
    "ConnectTimeoutSeconds": 5,
    "SyncTimeoutSeconds": 5
  }
}
