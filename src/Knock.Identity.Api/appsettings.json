{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "Region": "westus",
    "MaxPoolSize": 20,
    "ServerSelectionTimeoutSeconds": 5,
    "ConnectTimeoutSeconds": 5,
    "SocketTimeoutSeconds": 10,
    "QueryMaxTimeSeconds": 5,
    "Databases": {
      "Identity": "identity"
    }
  },
  "Redis": {
    "Database": 0,
    "ConnectTimeoutSeconds": 5,
    "SyncTimeoutSeconds": 5
  }
}
