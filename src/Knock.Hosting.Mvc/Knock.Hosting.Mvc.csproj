<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Knock.Hosting.Mvc</RootNamespace>
  </PropertyGroup>

  <!-- Spec 055 (enmienda 2026-11-24, pendiente de firma): piezas técnicas compartidas que dependen de MVC/controladores. Solo las referencian los servicios con controladores; el gateway no. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Knock.UnitTest" />
    <InternalsVisibleTo Include="Knock.IntegrationTest" />
    <InternalsVisibleTo Include="Knock.SecurityTest" />
  </ItemGroup>

</Project>
