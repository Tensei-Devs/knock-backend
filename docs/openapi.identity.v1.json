  "components": {
    "schemas": {
      "FirebaseExchangeRequest": {
        "type": "object",
        "properties": {
          "firebaseIdToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "deviceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "aceptaAviso": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "dispositivo": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Petición del canje (spec 015, R-03). Los campos son anulables a propósito y no se declaran requeridos en el esquema: si falta alguno, el validador\nresponde 422 con `errors` en su campo, en lugar del 400 automático de MVC. El celular y el `uid` no se aceptan: salen del token verificado."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Petición de renovación (spec 016, R-01). El campo es anulable a propósito: si falta, el validador responde 422 en su campo."
      },
      "RefreshResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "description": "Par nuevo de la renovación (spec 016, contrato). `ExpiresIn` son los segundos de vigencia del JWT de acceso."
      },
      "SessionResponse": {
        "required": [
          "accessToken",
          "refreshToken",
          "esNuevo",
          "perfilCompleto"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "esNuevo": {
            "type": "boolean"
          },
          "perfilCompleto": {
            "type": "boolean"
          }
        },
        "description": "Sesión emitida. `EsNuevo` distingue el 201 (cuenta creada) del 200 (cuenta existente)."
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Knock.Identity.Api"
