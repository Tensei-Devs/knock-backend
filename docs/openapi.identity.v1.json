      "post": {
        "tags": [
          "Refresh"
        ],
        "summary": "Cambia un token de renovación por un par nuevo (spec 016). Cualquier rechazo responde el mismo 401 sin motivo.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
