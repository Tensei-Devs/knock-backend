              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/colonias/existe": {
      "get": {
        "tags": [
          "ColoniaExists"
        ],
        "summary": "200 en ambos casos; el nombre se compara sin mayúsculas ni acentos y no se registra. El 422 lo da `ValidationFilter` antes de esta acción.",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "description": "Name of the colonia. Letters, digits, spaces and . , ' ’ ( ) / # - ; up to 80 characters. Exactly one value. Case and accents are ignored.",
            "required": true,
            "schema": {
              "maxLength": 80,
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/colonias/en-punto": {
      "get": {
        "tags": [
          "Colonias"
        ],
        "summary": "Colonia del punto o «fuera de cobertura» (200 en ambos casos). Las coordenadas se convierten en colonia y se descartan: no se\nguardan, no se registran, no se cachean y no vuelven en la respuesta. El 422 lo da `ValidationFilter` antes de esta acción.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude in decimal degrees, from -90 to 90, dot as decimal separator, up to 10 decimals. Exactly one value.",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^-?\\d{1,3}(\\.\\d{1,10})?$",
              "type": "string"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Longitude in decimal degrees, from -180 to 180, dot as decimal separator, up to 10 decimals. Exactly one value.",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^-?\\d{1,3}(\\.\\d{1,10})?$",
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/oficios": {
      "get": {
        "tags": [
          "Oficios"
        ],
        "summary": "Oficios activos como arreglo sin paginar: excepción documentada a la constitución §11 (catálogo acotado, D9).\n`[AllowAnonymous]` explícito para que siga público aunque se agregue una política de autorización global (D3).",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OficioResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Appointment": {
        "required": [
          "visitaId",
          "solicitudId",
          "cotizacionId",
          "estado",
          "modalidad",
          "dia",
          "hora",
          "precio",
          "tope",
          "tecnico",
          "lugar"
        ],
        "type": "object",
        "properties": {
          "visitaId": {
            "type": "string"
          },
          "solicitudId": {
            "type": "string"
          },
          "cotizacionId": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "modalidad": {
            "type": "string"
          },
          "dia": {
            "type": "string"
          },
          "hora": {
            "type": "string"
          },
          "precio": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "tope": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "tecnico": {
            "$ref": "#/components/schemas/ChosenTechnician"
          },
          "lugar": {
            "$ref": "#/components/schemas/AppointmentPlace"
          }
        },
        "description": "Cita confirmada al elegir una cotización (spec 021, §5)."
      },
      "AppointmentPlace": {
        "required": [
          "tipo",
          "direccion"
        ],
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          }
        },
        "description": "Lugar de la cita: tipo (`domicilio` o `taller`) y dirección."
      },
      "ChooseQuoteBody": {
        "required": [
          "cotizacionId"
        ],
        "type": "object",
        "properties": {
          "cotizacionId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identificador (24 hexadecimales) de la cotización que se elige."
          }
        },
        "description": "Cuerpo de `POST /solicitudes/{id}/elegir`."
      },
      "ChosenTechnician": {
        "required": [
          "id",
          "nombre",
          "fotoUrl",
          "verificado",
          "nivelVerificacion",
          "telefono",
          "whatsapp"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "fotoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "verificado": {
            "type": "boolean"
          },
          "nivelVerificacion": {
            "type": "string"
          },
          "telefono": {
            "type": [
              "null",
              "string"
            ]
          },
          "whatsapp": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Técnico elegido, con el contacto público que se revela solo después de elegir."
      },
      "CreateRequestBody": {
        "required": [
          "oficioClave",
          "descripcion",
          "fotos",
          "dia",
          "franja",
          "coloniaId",
          "direccion"
        ],
        "type": "object",
        "properties": {
          "oficioClave": {
            "type": [
              "null",
              "string"
            ],
            "description": "Clave de un oficio activo del catálogo. La modalidad (domicilio o taller) la dicta el oficio."
          },
          "descripcion": {
            "type": [
              "null",
              "string"
            ],
            "description": "De 8 a 500 caracteres; pasa por moderación antes de guardarse."
          },
          "fotos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "De 1 a 5 identificadores de archivo (24 hexadecimales), sin repetidos, de archivos ya confirmados del mismo usuario."
          },
          "dia": {
            "type": [
              "null",
              "string"
            ],
            "description": "Fecha `YYYY-MM-DD` en la zona America/Mexico_City, de hoy a hoy + 5 días."
          },
          "franja": {
            "type": [
              "null",
              "string"
            ],
            "description": "Una de `manana`, `tarde` o `noche`."
          },
          "coloniaId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identificador (24 hexadecimales) de una colonia del catálogo."
          },
          "direccion": {
            "type": [
              "null",
              "string"
            ],
            "description": "De 8 a 200 caracteres; obligatoria en modalidad domicilio y no admitida en taller. Se guarda cifrada."
          }
        },
        "description": "Cuerpo de `POST /solicitudes` (spec 020, R-01). El 422 lo da `CreateRequestBodyValidator`; nunca repite el valor recibido."
      },
      "NeighborhoodAtPointColoniaResponse": {
        "required": [
          "id",
          "nombre",
          "cp",
          "municipio"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "cp": {
            "type": "string"
          },
          "municipio": {
            "type": "string"
          }
        }
      },
