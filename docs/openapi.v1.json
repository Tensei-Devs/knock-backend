{
  "openapi": "3.2.0",
  "info": {
    "title": "Knock.Market.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v{version}/colonias/existe": {
      "get": {
        "tags": [
          "ColoniaExists"
        ],
        "summary": "200 en ambos casos; el nombre se compara sin mayúsculas ni acentos y no se registra. El 422 lo da `ValidationFilter` antes de esta acción.",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "description": "Name of the colonia. Letters, digits, spaces and . , ' ’ ( ) / # - ; up to 80 characters. Exactly one value. Case and accents are ignored.",
            "required": true,
            "schema": {
              "maxLength": 80,
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/colonias/en-punto": {
      "get": {
        "tags": [
          "Colonias"
        ],
        "summary": "Colonia del punto o «fuera de cobertura» (200 en ambos casos). Las coordenadas se convierten en colonia y se descartan: no se\nguardan, no se registran, no se cachean y no vuelven en la respuesta. El 422 lo da `ValidationFilter` antes de esta acción.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude in decimal degrees, from -90 to 90, dot as decimal separator, up to 10 decimals. Exactly one value.",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^-?\\d{1,3}(\\.\\d{1,10})?$",
              "type": "string"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Longitude in decimal degrees, from -180 to 180, dot as decimal separator, up to 10 decimals. Exactly one value.",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^-?\\d{1,3}(\\.\\d{1,10})?$",
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/zonas/lista-espera": {
      "post": {
        "tags": [
          "ListaEspera"
        ],
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WaitlistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/oficios": {
      "get": {
        "tags": [
          "Oficios"
        ],
        "summary": "Oficios activos como arreglo sin paginar: excepción documentada a la constitución §11 (catálogo acotado, D9).\n`[AllowAnonymous]` explícito para que siga público aunque se agregue una política de autorización global (D3).\nResponde con `ETag` débil, `Cache-Control: public, max-age=0, must-revalidate` y `Vary: Accept-Encoding` (la respuesta comprimida es otra variante);\ncon `If-None-Match` vigente responde 304 sin cuerpo.",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OficioResponse"
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NeighborhoodAtPointColoniaResponse": {
        "required": [
          "id",
          "nombre",
          "cp",
          "municipio"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "cp": {
            "type": "string"
          },
          "municipio": {
            "type": "string"
          }
        }
      },
      "NeighborhoodAtPointResponse": {
        "required": [
          "enCobertura",
          "colonia"
        ],
        "type": "object",
        "properties": {
          "enCobertura": {
            "type": "boolean"
          },
          "colonia": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NeighborhoodAtPointColoniaResponse"
              }
            ]
          }
        }
      },
      "NeighborhoodExistsResponse": {
        "required": [
          "existe"
        ],
        "type": "object",
        "properties": {
          "existe": {
            "type": "boolean"
          }
        }
      },
      "OficioResponse": {
        "required": [
          "clave",
          "nombre",
          "modalidad"
        ],
        "type": "object",
        "properties": {
          "clave": {
            "type": "string",
            "description": "Clave estable del catálogo (≤ 16 caracteres)."
          },
          "nombre": {
            "type": "string",
            "description": "Nombre para mostrar, en español (≤ 100 caracteres)."
          },
          "modalidad": {
            "type": "string",
            "description": "Valores conocidos: `domicilio` o `taller`. Es texto, no enum cerrado, para admitir modalidades futuras."
          }
        },
        "description": "Oficio activo del catálogo tal como lo ve la app: solo clave, nombre y modalidad (nunca id ni activo)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "WaitlistRequest": {
        "required": [
          "cp",
          "municipio"
        ],
        "type": "object",
        "properties": {
          "cp": {
            "type": [
              "null",
              "string"
            ]
          },
          "municipio": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "WaitlistResponse": {
        "required": [
          "id",
          "cp",
          "municipio",
          "creadoEn",
          "yaRegistrado"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cp": {
            "type": "string"
          },
          "municipio": {
            "type": [
              "null",
              "string"
            ]
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time"
          },
          "yaRegistrado": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ColoniaExists"
    },
    {
      "name": "Colonias"
    },
    {
      "name": "ListaEspera"
    },
    {
      "name": "Oficios"
    }
  ]
}
