    "/api/v{version}/oficios": {
      "get": {
        "tags": [
          "Oficios"
        ],
        "summary": "Oficios activos como arreglo sin paginar: excepción documentada a la constitución §11 (catálogo acotado, D9).\n`[AllowAnonymous]` explícito para que siga público aunque se agregue una política de autorización global (D3).\nResponde con `ETag` débil, `Cache-Control: public, max-age=0, must-revalidate` y `Vary: Accept-Encoding` (la respuesta comprimida es otra variante);\ncon `If-None-Match` vigente responde 304 sin cuerpo.",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OficioResponse"
                  }
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRequestBody": {
        "required": [
          "oficioClave",
          "descripcion",
          "fotos",
          "dia",
          "franja",
          "coloniaId",
          "direccion"
        ],
        "type": "object",
        "properties": {
          "oficioClave": {
            "type": [
              "null",
              "string"
            ],
            "description": "Clave de un oficio activo del catálogo. La modalidad (domicilio o taller) la dicta el oficio."
          },
          "descripcion": {
            "type": [
              "null",
              "string"
            ],
            "description": "De 8 a 500 caracteres; pasa por moderación antes de guardarse."
          },
          "fotos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            },
            "description": "De 1 a 5 identificadores de archivo (24 hexadecimales), sin repetidos, de archivos ya confirmados del mismo usuario."
          },
          "dia": {
            "type": [
              "null",
              "string"
            ],
            "description": "Fecha `YYYY-MM-DD` en la zona America/Mexico_City, de hoy a hoy + 5 días."
          },
          "franja": {
            "type": [
              "null",
              "string"
            ],
            "description": "Una de `manana`, `tarde` o `noche`."
          },
          "coloniaId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Identificador (24 hexadecimales) de una colonia del catálogo."
          },
          "direccion": {
            "type": [
              "null",
              "string"
            ],
            "description": "De 8 a 200 caracteres; obligatoria en modalidad domicilio y no admitida en taller. Se guarda cifrada."
          }
        },
        "description": "Cuerpo de `POST /solicitudes` (spec 020, R-01). El 422 lo da `CreateRequestBodyValidator`; nunca repite el valor recibido."
      },
      "NeighborhoodAtPointColoniaResponse": {
        "required": [
          "id",
          "nombre",
          "cp",
          "municipio"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "cp": {
            "type": "string"
          },
          "municipio": {
            "type": "string"
          }
        }
      },
      "NeighborhoodAtPointResponse": {
        "required": [
          "enCobertura",
          "colonia"
        ],
        "type": "object",
        "properties": {
          "enCobertura": {
            "type": "boolean"
          },
          "colonia": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NeighborhoodAtPointColoniaResponse"
              }
            ]
          }
        }
      },
      "NeighborhoodExistsResponse": {
        "required": [
          "existe"
        ],
        "type": "object",
        "properties": {
          "existe": {
            "type": "boolean"
          }
        }
      },
      "OficioResponse": {
        "required": [
          "clave",
          "nombre",
          "modalidad"
        ],
        "type": "object",
        "properties": {
          "clave": {
            "type": "string",
            "description": "Clave estable del catálogo (≤ 16 caracteres)."
          },
          "nombre": {
            "type": "string",
            "description": "Nombre para mostrar, en español (≤ 100 caracteres)."
          },
          "modalidad": {
            "type": "string",
            "description": "Valores conocidos: `domicilio` o `taller`. Es texto, no enum cerrado, para admitir modalidades futuras."
          }
        },
        "description": "Oficio activo del catálogo tal como lo ve la app: solo clave, nombre y modalidad (nunca id ni activo)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RequestNeighborhood": {
        "required": [
          "id",
          "nombre",
          "cp"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "cp": {
            "type": "string"
          }
        },
        "description": "Colonia de la solicitud: identificador, nombre y código postal."
      },
      "RequestPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestSummary"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Página de solicitudes propias; `NextCursor` es `null` en la última página."
      },
      "RequestPhoto": {
        "required": [
          "id",
          "url",
          "venceEn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "venceEn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Foto privada de la solicitud: el enlace de lectura vence a los 5 minutos y la app lo vuelve a pedir con el detalle."
      },
      "RequestResponse": {
        "required": [
          "id",
          "estado",
          "modalidad",
          "oficio",
          "colonia",
          "descripcion",
          "fotos",
          "dia",
          "franja",
          "direccion",
          "totalCotizaciones",
          "venceEn",
          "creadoEn"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          },
          "modalidad": {
            "type": "string"
          },
          "oficio": {
            "$ref": "#/components/schemas/RequestTrade"
          },
          "colonia": {
            "$ref": "#/components/schemas/RequestNeighborhood"
          },
          "descripcion": {
            "type": "string"
          },
          "fotos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequestPhoto"
            }
          },
          "dia": {
            "type": "string"
          },
          "franja": {
            "type": "string"
          },
          "direccion": {
            "type": [
              "null",
              "string"
            ]
          },
          "totalCotizaciones": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
