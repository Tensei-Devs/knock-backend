                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/colonias/existe": {
      "get": {
        "tags": [
          "ColoniaExists"
        ],
        "summary": "200 en ambos casos; el nombre se compara sin mayúsculas ni acentos y no se registra. El 422 lo da `ValidationFilter` antes de esta acción.",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "description": "Name of the colonia. Letters, digits, spaces and . , ' ’ ( ) / # - ; up to 80 characters. Exactly one value. Case and accents are ignored.",
            "required": true,
            "schema": {
              "maxLength": 80,
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodExistsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v{version}/colonias/en-punto": {
      "get": {
        "tags": [
          "Colonias"
        ],
        "summary": "Colonia del punto o «fuera de cobertura» (200 en ambos casos). Las coordenadas se convierten en colonia y se descartan: no se\nguardan, no se registran, no se cachean y no vuelven en la respuesta. El 422 lo da `ValidationFilter` antes de esta acción.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude in decimal degrees, from -90 to 90, dot as decimal separator, up to 10 decimals. Exactly one value.",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^-?\\d{1,3}(\\.\\d{1,10})?$",
              "type": "string"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "description": "Longitude in decimal degrees, from -180 to 180, dot as decimal separator, up to 10 decimals. Exactly one value.",
            "required": true,
            "schema": {
              "maxLength": 16,
              "pattern": "^-?\\d{1,3}(\\.\\d{1,10})?$",
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodAtPointResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
